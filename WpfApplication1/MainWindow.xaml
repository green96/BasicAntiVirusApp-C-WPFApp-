<!--Title="MainWindow" Height="318" Width="530" ==> chỉnh width và height của Page/Window có title là MainWindow-->
<Window x:Class="WpfApplication1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="318" Width="530">

    <!--Lưu ý các thuộc tính và sự kiện có thể được chọn ở table Properties (Nhớ chọn component muốn thay đổi trước(có 2 options Event Handle và Properties))-->
    
    <!--Phải luôn có thẻ Window và Grid và các thành phần giao diện phải bỏ trong Thẻ Grid-->
    <Grid>
        <!--StackPanel giống flexbox css nhưng mặc định từ trên xuống (giống Stack) ==> Orientation="Horizontal" để override mặc định ==> hiện từ trái qua phải--> 
        <StackPanel Orientation="Horizontal" Height="35" VerticalAlignment="Top">
            <Button Content="Page 1" MinWidth="100" Click="ClickMoveToPage1"/>
            <Button Content="Page 2" MinWidth="100" Click="ClickMoveToPage2" Margin="10,0,0,0" />
        </StackPanel>

        <!--x:Name="Main" ==> gọi Main để truy xuất component Frame này-->
        <!--Frame = Container to hold all pages-->
        <Frame x:Name="Main" Margin="0,35,0,0" NavigationUIVisibility="Hidden" />
    </Grid>
     
</Window>
