                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation  Storyboard.TargetProperty="Width" To="30" Duration="0:0:0.3"/>
                                                <DoubleAnimation  Storyboard.TargetProperty="Height" To="35" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>

                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <!--Apply cái mẫu Style Border này vào Background của Button bằng TemplateBinding-->
                            <Border  Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" CornerRadius="12" Background="{TemplateBinding Background}">


                                <!--Hiện content của button và style mới của nó(hiện:Text...) bằng ContentPresenter-->
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />


                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                </Button>
            </StackPanel>
        </Grid>

    </Grid>
</Page>
