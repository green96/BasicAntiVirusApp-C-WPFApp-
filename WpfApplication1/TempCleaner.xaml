<!--Thêm thuộc tính Background="White" cho thẻ Page và Grid để dễ thiết kế giao diện-->
<Page x:Class="WpfApplication1.CleanerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="300" d:DesignWidth="300"
	  Title="TempCleaner" Height="318" Width="530" Background="#181735"
      >

    <!--Phải luôn có thẻ Window và Grid và các thành phần giao diện phải bỏ trong Thẻ Grid-->
    <Grid Margin="0,0,2,1">


        <!--Định nghĩa Height Width Row Và Column-->
        <Grid.RowDefinitions>
            <RowDefinition Height="318">
                <!--Tạo 1 Row Chính có Height="318" ==> Cao Toàn Bộ Window-->
            </RowDefinition>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="530">
                <!--Tạo 1 Column Chính có Width="530" ==> dài toàn window-->
            </ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid Background="#0F0F2D" Grid.ColumnSpan="1" >
            <!--Tạo 9 Column có độ dài bằng nhau để design cho đồng điều-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <!--Grid.Column="0"-->
                <ColumnDefinition/>
                <!--Grid.Column="1"-->
                <ColumnDefinition/>
                <!--Grid.Column="2"-->
                <ColumnDefinition/>
                <!--Grid.Column="3"-->
                <ColumnDefinition/>
                <!--Grid.Column="4"-->
                <ColumnDefinition/>
                <!--Grid.Column="5"-->
                <ColumnDefinition/>
                <!--Grid.Column="6"-->
                <ColumnDefinition/>
                <!--Grid.Column="7"-->
                <ColumnDefinition/>
                <!--Grid.Column="8"-->
            </Grid.ColumnDefinitions>

            <!--Tạo 9 Row có độ dài bằng nhau để design cho đồng điều-->
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <!--Grid.Row="0"-->
                <RowDefinition></RowDefinition>
                <!--Grid.Row="1"-->
                <RowDefinition></RowDefinition>
                <!--Grid.Row="2"-->
                <RowDefinition></RowDefinition>
                <!--Grid.Row="3"-->
                <RowDefinition></RowDefinition>
                <!--Grid.Row="4"-->
                <RowDefinition></RowDefinition>
                <!--Grid.Row="5"-->
                <RowDefinition></RowDefinition>
                <!--Grid.Row="6"-->
                <RowDefinition></RowDefinition>
                <!--Grid.Row="7"-->
                <RowDefinition></RowDefinition>
                <!--Grid.Row="8"-->
            </Grid.RowDefinitions>

            <!--Grid.Column="1" ==> Element này xuất hiện ở column thứ 2-->
            <TextBlock Text="Bleu Basic"
                       Foreground="LightGray"
                       Grid.Column="3"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontFamily="/Fonts/#Dosis"
                       FontWeight="Medium"
                       />

            <TextBlock Text="AntiVirus"
                       Foreground="White"
                       Grid.Column="4"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontFamily="/Fonts/#Dosis"
                       FontWeight="Medium"
                       Cursor="Help"
                       />

            <TextBlock Text="PC Cleaner"
                       Foreground="LightGray"
                       Grid.Column="5"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontFamily="/Fonts/#Dosis"
                       FontWeight="Medium"
                       />

            <Button x:Name="ClearTempbtn" Content="Clear Temp" MinWidth="100" Click="ClickMoveToClearTemp" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Height="35" VerticalAlignment="Top">

                <!--Tạo Style Cho Button (TargetType="Button" ==> chọn element để style là Button)-->
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="TextElement.FontFamily" Value="Fonts/#Dosis"/>
                        <Setter Property="Background" Value="#39385D"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Foreground" Value="White"/>
                        <!--Foreground ở đây là text của button đó-->
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3952"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <!--Apply cái mẫu Style Border này vào Background của Button bằng TemplateBinding-->
                        <Border Width="100" Height="25" CornerRadius="12" Background="{TemplateBinding Background}">


                            <!--Hiện content của button và style mới của nó(hiện:Text...) bằng ContentPresenter-->
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />


                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>


            <Button x:Name="ClearPrefetchbtn" Content="Clear Prefetch" MinWidth="100" Click="ClickMoveToClearPrefetch" Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2">

                <!--Tạo Style Cho Button (TargetType="Button" ==> chọn element để style là Button)-->
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="TextElement.FontFamily" Value="Fonts/#Dosis"/>
                        <Setter Property="Background" Value="#39385D"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Foreground" Value="White"/>
                        <!--Foreground ở đây là text của button đó-->
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3952"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <!--Apply cái mẫu Style Border này vào Background của Button bằng TemplateBinding-->
                        <Border Width="100" Height="25" CornerRadius="12" Background="{TemplateBinding Background}">


                            <!--Hiện content của button và style mới của nó(hiện:Text...) bằng ContentPresenter-->
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />


                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>

            <!--StackPanel giống flexbox css nhưng mặc định từ trên xuống (giống Stack) ==> Orientation="Horizontal" để override mặc định ==> hiện từ trái qua phải-->
            <!--Grid.Column="1": bắt đầu từ cột thứ 2 (đếm từ 0). Grid.ColumnSpan="7": chiếm 7 cột liên tiếp từ cột đã chọn, tức là Grid.Column=1, 2, 3, 4, 5 ,6, 7(hiểu tương tự với Grid.Row="6")-->
            <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="7" Orientation="Horizontal" Height="35" VerticalAlignment="Top">
                <Button Content="Home" MinWidth="60" Click="ClickBackToMain" Height="35" VerticalAlignment="Top">
                    <!--Tạo Style Cho Button (TargetType="Button" ==> chọn element để style là Button)-->
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="TextElement.FontFamily" Value="Fonts/#Dosis"/>
                            <Setter Property="Background" Value="#FE6584"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Foreground" Value="White"/>
                            <!--Foreground ở đây là text của button đó-->
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF4C70"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <!--Apply cái mẫu Style Border này vào Background của Button bằng TemplateBinding-->
                            <Border Width="60" Height="25" CornerRadius="12" Background="{TemplateBinding Background}">


                                <!--Hiện content của button và style mới của nó(hiện:Text...) bằng ContentPresenter-->
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />


                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                </Button>
                <Button Content="Page 1" MinWidth="100" Click="ClickMoveToPage1" Margin="10,0,0,0">
                    <!--Tạo Style Cho Button (TargetType="Button" ==> chọn element để style là Button)-->
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="TextElement.FontFamily" Value="Fonts/#Dosis"/>
                            <Setter Property="Background" Value="#FE6584"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Foreground" Value="White"/>
                            <!--Foreground ở đây là text của button đó-->
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF4C70"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <!--Apply cái mẫu Style Border này vào Background của Button bằng TemplateBinding-->
                            <Border Width="100" Height="25" CornerRadius="12" Background="{TemplateBinding Background}">


                                <!--Hiện content của button và style mới của nó(hiện:Text...) bằng ContentPresenter-->
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />


                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                </Button>
                <Button Content="Page 2" MinWidth="100" Click="ClickMoveToPage2" Margin="10,0,0,0">

                    <!--Tạo Style Cho Button (TargetType="Button" ==> chọn element để style là Button)-->
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="TextElement.FontFamily" Value="Fonts/#Dosis"/>
                            <Setter Property="Background" Value="#39385D"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Foreground" Value="White"/>
                            <!--Foreground ở đây là text của button đó-->
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3A3952"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <!--Apply cái mẫu Style Border này vào Background của Button bằng TemplateBinding-->
                            <Border Width="100" Height="25" CornerRadius="12" Background="{TemplateBinding Background}">


                                <!--Hiện content của button và style mới của nó(hiện:Text...) bằng ContentPresenter-->
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />


                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                </Button>
                <Button Content="Page 3" MinWidth="100" Click="ClickMoveToPage3" Margin="10,0,0,0">
                    <!--Tạo Style Cho Button (TargetType="Button" ==> chọn element để style là Button)-->
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="TextElement.FontFamily" Value="Fonts/#Dosis"/>
                            <Setter Property="Background" Value="#FE6584"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Foreground" Value="White"/>
                            <!--Foreground ở đây là text của button đó-->
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF4C70"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <!--Apply cái mẫu Style Border này vào Background của Button bằng TemplateBinding-->
                            <Border Width="100" Height="25" CornerRadius="12" Background="{TemplateBinding Background}">


                                <!--Hiện content của button và style mới của nó(hiện:Text...) bằng ContentPresenter-->
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />


                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                </Button>
            </StackPanel>
        </Grid>

    </Grid>
</Page>
