<!--Thêm thuộc tính Background="White" cho thẻ Page và Grid để dễ thiết kế giao diện (WPF sẽ sử dụng 1 nên giao diện chung từ MainWindow Qua(Nên layout các Page phải giống layout MainWindow chỉ khác về Các UI,Button...))-->
<!--Trong Page khai báo namespace local để nhận diện được FileSizeConverter và IconConverter-->
    <Page x:Class="WpfApplication1.StorageAnalyzierPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:WpfApplication1"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="300" d:DesignWidth="300"
	  Title="StorageAnalyzierPage" 
      Height="318" Width="530"
      Background="#181735"
      >
    <!--Xử lý Converter với tiền tố(prefix) là local(có thể hiểu là thư viện cho phép truy cập file trong PC)-->
    <Page.Resources>
        <local:FileSizeConverter x:Key="FileSizeConverter" />
        <local:IconConverter x:Key="IconConverter" />
    </Page.Resources>
    <!--Lưu ý các thuộc tính và sự kiện có thể được chọn ở table Properties (Nhớ chọn component muốn thay đổi trước(có 2 options Event Handle và Properties))-->

    <!--Phải luôn có thẻ Window và Grid và các thành phần giao diện phải bỏ trong Thẻ Grid-->
    <Grid>

        <!--Định nghĩa Height Width Row Và Column-->
        <Grid.RowDefinitions>
            <RowDefinition Height="318">
                <!--Tạo 1 Row Chính có Height="318" ==> Cao Toàn Bộ Window-->
            </RowDefinition>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="530">
                <!--Tạo 1 Column Chính có Width="530" ==> dài toàn window-->
            </ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid Background="#0F0F2D" Grid.ColumnSpan="1" >
            <!--Tạo 9 Column có độ dài bằng nhau để design cho đồng điều-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <!--Grid.Column="0"-->
                <ColumnDefinition/>
                <!--Grid.Column="1"-->
                <ColumnDefinition/>
                <!--Grid.Column="2"-->
                <ColumnDefinition/>
                <!--Grid.Column="3"-->
                <ColumnDefinition/>
                <!--Grid.Column="4"-->
                <ColumnDefinition/>
                <!--Grid.Column="5"-->
                <ColumnDefinition/>
                <!--Grid.Column="6"-->
                <ColumnDefinition/>
                <!--Grid.Column="7"-->
                <ColumnDefinition/>
                <!--Grid.Column="8"-->
            </Grid.ColumnDefinitions>

            <!--Tạo 9 Row có độ dài bằng nhau để design cho đồng điều-->
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <!--Grid.Row="0"-->
                <RowDefinition></RowDefinition>
                <!--Grid.Row="1"-->
                <RowDefinition></RowDefinition>
                <!--Grid.Row="2"-->
                <RowDefinition></RowDefinition>
                <!--Grid.Row="3"-->
                <RowDefinition></RowDefinition>
                <!--Grid.Row="4"-->
                <RowDefinition></RowDefinition>
                <!--Grid.Row="5"-->
                <RowDefinition></RowDefinition>
                <!--Grid.Row="6"-->
                <RowDefinition></RowDefinition>
                <!--Grid.Row="7"-->
                <RowDefinition></RowDefinition>
                <!--Grid.Row="8"-->
            </Grid.RowDefinitions>

            <!--Grid.Column="1" ==> Element này xuất hiện ở column thứ 2 ==> tương tự Grid.Column="3" ==> Element này xuất hiện ở column thứ 4 -->
            <TextBlock Text="Bleu Basic"
                       Foreground="LightGray"
                       Grid.Column="3"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontFamily="/Fonts/#Dosis"
                       FontWeight="Medium"
                       />

            <TextBlock Text="AntiVirus"
                       Foreground="LightGray"
                       Grid.Column="4"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontFamily="/Fonts/#Dosis"
                       FontWeight="Medium"
                       Cursor="Help"
                       />

            <TextBlock Text="PC Cleaner"
                       Foreground="White"
                       Grid.Column="5"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontFamily="/Fonts/#Dosis"
                       FontWeight="Medium"
                       />
            <!--This Page Main Content-->

            <TextBlock Text="Storage Analysis"
                       Foreground="White"
                       Grid.Column="0"
                       Grid.Row="1"
                       Grid.ColumnSpan="4"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontFamily="/Fonts/#Dosis"
                       FontWeight="Medium" 
                       FontSize="22"
                       />

            <TextBox Grid.Row="2" Grid.ColumnSpan="5" x:Name="FilePathTxt" PreviewKeyDown="FilePathTxt_PreviewKeyDown" TextWrapping="Wrap" FontSize="14" Padding="5" VerticalAlignment="Center" />

            <Button Grid.Row="2" Grid.Column="5" Name="ChooseBtn" Click="ChooseBtn_Click" DockPanel.Dock="Right" ToolTip="Choose folder" MinWidth="60">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Height="24" Width="24" Source="Images/opened-folder.png"/>
                </StackPanel>
            </Button>

            <ScrollViewer Grid.Row="3" Grid.RowSpan="4" Grid.ColumnSpan="5"  x:Name="Scroller" VerticalScrollBarVisibility="Auto" Background="#39385D">
                <ItemsControl x:Name="FolderItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="FileItem_Click" Tag="{Binding}" ToolTip="{Binding FilePath}" DockPanel.Dock="Right" Padding="5,3" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                <DockPanel VerticalAlignment="Center">
                                    <Image Height="24" Width="24" Source="{Binding Path=IsFolder, Converter={StaticResource IconConverter}}"/>
                                    <!--TextBlock với đường dẫn là Path=FileSize và Binding FileName cho TextBlock dưới-->
                                    <TextBlock Text="{Binding Path=FileSize, Converter={StaticResource FileSizeConverter}}" DockPanel.Dock="Right" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White"/>
                                    <TextBlock Text="{Binding FileName}" Margin="10,0,10,2" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="White"/>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Column="6" Grid.ColumnSpan="3" Grid.Row="0" Grid.RowSpan="7" Background="#39385D" Margin="0,0,10,0">
                <TextBlock Margin="20,15,20,0" FontSize="14" Text="Total folder size" Foreground="White" />
                <TextBlock x:Name="FolderSizeLbl" Margin="20,0,20,15" FontSize="16" Text="0 MB" FontWeight="SemiBold" Foreground="White"/>
                <Rectangle Height="2" Fill="DodgerBlue" Margin="15,0"/>
                <ComboBox x:Name="DriveCombo" SelectionChanged="DriveCombo_SelectionChanged" Margin="15,10,15,0" FontSize="14"/>
                <TextBlock Margin="20,5,20,0" FontSize="14" Text="Space taken" Foreground="White"/>
                <TextBlock x:Name="DriveSpaceTakenLbl" Margin="20,0,20,0" FontSize="16" Text="0 MB" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Margin="20,5,20,0" FontSize="14" Text="Remaining space" Foreground="White"/>
                <TextBlock x:Name="DriveRemainingSpaceLbl" Margin="20,0,20,0" FontSize="16" Text="0 MB" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Margin="20,5,20,0" FontSize="14" Text="Total space" Foreground="White"/>
                <TextBlock x:Name="DriveTotalSpaceLbl" Margin="20,0,20,15" FontSize="16" Text="0 MB" FontWeight="SemiBold" Foreground="White"/>
            </StackPanel>


            <!--StackPanel giống flexbox css nhưng mặc định từ trên xuống (giống Stack) ==> Orientation="Horizontal" để override mặc định ==> hiện từ trái qua phải-->
            <!--Grid.Column="3": bắt đầu từ cột thứ 4 (đếm từ 0). Grid.ColumnSpan="4": chiếm 4 cột liên tiếp từ cột đã chọn, tức là Grid.Column=3,4,5,6 (hiểu tương tự với Grid.Row="6")-->
            <StackPanel Grid.Row="7" Grid.Column="3" Grid.ColumnSpan="4" Orientation="Horizontal" Height="35" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform Y="-7"/>
                    </TransformGroup>
                </StackPanel.RenderTransform>
                <!--Add Image To Button (Thẻ Image phải ở trong thẻ Button)-->
                <Button Width="30" Height="30" Click="ClickBackToMain">

                    <!--Lưu ý: không thể ép Button nhận cả Content="Home" lẫn thẻ <Image> bên trong Một Button-->
                    <!--Add Image To Button (Thẻ Image phải ở trong thẻ Button)-->
                    <Image Height="24" Width="24" Source="Images/home_and_garden_24dp_FFFFFF_FILL0_wght400_GRAD0_opsz24.png"/>


                    <!--Tạo Style Cho Button (TargetType="Button" ==> chọn element để style là Button)-->
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="TextElement.FontFamily" Value="Fonts/#Dosis"/>
                            <Setter Property="Background" Value="#39385D"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Foreground" Value="White"/>
                            <!--Foreground ở đây là text của button đó-->

                            <!--Xử lý sự kiện Trigger và Animation bằng Storyboards VD: OnClick,IsMouseOver-->
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">

                                    <!--Setter ==> gán các thuộc tính của button khi IsMouseOver-->
                                    <Setter Property="Background" Value="#FF646287"/>

                                    <!--Trigger.EnterActions ==> Is An Action That Play When IsMouseOver is True (Chuột di chuyển qua cái nút)-->
                                    <Trigger.EnterActions>

                                        <!--Animation Tag Here (Storyboard allow us to group animation together )
                                        Storyboard.TargetProperty="Width" To="35" Duration="0:0:0.3" ==> change Button Width to 35 For 0.3 seconds When EnterActions
                                        -->
                                        <BeginStoryboard Name="MouseEnterStoryboard">
                                            <Storyboard>
                                                <DoubleAnimation  Storyboard.TargetProperty="Width" To="35" Duration="0:0:0.3"/>
                                                <DoubleAnimation  Storyboard.TargetProperty="Height" To="35" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>

                                    </Trigger.EnterActions>

                                    <!--Trigger.EnterActions ==> Is An Action That Play When IsMouseOver is False (Chuột Không di chuyển qua cái nút nữa)-->
                                    <Trigger.ExitActions>
                                        <!--Reset Storyboard trước để tránh bug Animation-->
                                        <StopStoryboard BeginStoryboardName="MouseEnterStoryboard"/>

                                        <!--Animation Tag Here (Storyboard allow us to group animation together )-->
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation  Storyboard.TargetProperty="Width" To="30" Duration="0:0:0.3"/>
                                                <DoubleAnimation  Storyboard.TargetProperty="Height" To="30" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>

                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <!--Apply cái mẫu Style Border này vào Background của Button bằng TemplateBinding
                            Width="{TemplateBinding Width} ==> Apply thuộc tính Width đã tạo ở trên Của Button vào Border
                            Height="{TemplateBinding Height ==> Apply thuộc tính Width đã tạo ở trên Của Button vào Border
                            -->
                            <Border Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" CornerRadius="12" Background="{TemplateBinding Background}">


                                <!--Hiện content của button và style mới của nó(hiện:Text...) bằng ContentPresenter-->
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />


                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                </Button>
                <Button  Width="30" Height="30" Click="ClickMoveToPage1" Margin="10,0,0,0">

                    <!--Lưu ý: không thể ép Button nhận cả Content="Home" lẫn thẻ <Image> bên trong Một Button-->
                    <!--Add Image To Button (Thẻ Image phải ở trong thẻ Button)-->
                    <Image Height="24" Width="24" Source="Images/shield_locked_24dp_FFFFFF_FILL0_wght400_GRAD0_opsz24.png"/>

                    <!--Tạo Style Cho Button (TargetType="Button" ==> chọn element để style là Button)-->
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="TextElement.FontFamily" Value="Fonts/#Dosis"/>
                            <Setter Property="Background" Value="#FE6584"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Foreground" Value="White"/>
                            <!--Foreground ở đây là text của button đó-->
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF4C70"/>

                                    <!--Trigger.EnterActions ==> Is An Action That Play When IsMouseOver is True (Chuột di chuyển qua cái nút)-->
                                    <Trigger.EnterActions>

                                        <!--Animation Tag Here (Storyboard allow us to group animation together )
                                        Storyboard.TargetProperty="Width" To="35" Duration="0:0:0.3" ==> change Button Width to 35 For 0.3 seconds When EnterActions
                                        -->
                                        <BeginStoryboard Name="MouseEnterStoryboard">
                                            <Storyboard>
                                                <DoubleAnimation  Storyboard.TargetProperty="Width" To="35" Duration="0:0:0.3"/>
                                                <DoubleAnimation  Storyboard.TargetProperty="Height" To="35" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>

                                    </Trigger.EnterActions>

                                    <!--Trigger.EnterActions ==> Is An Action That Play When IsMouseOver is False (Chuột Không di chuyển qua cái nút nữa)-->
                                    <Trigger.ExitActions>
                                        <!--Reset Storyboard trước để tránh bug Animation-->
                                        <StopStoryboard BeginStoryboardName="MouseEnterStoryboard"/>

                                        <!--Animation Tag Here (Storyboard allow us to group animation together )-->
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation  Storyboard.TargetProperty="Width" To="30" Duration="0:0:0.3"/>
                                                <DoubleAnimation  Storyboard.TargetProperty="Height" To="35" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>

                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <!--Apply cái mẫu Style Border này vào Background của Button bằng TemplateBinding-->
                            <Border  Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" CornerRadius="12" Background="{TemplateBinding Background}">


                                <!--Hiện content của button và style mới của nó(hiện:Text...) bằng ContentPresenter-->
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />


                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                </Button>
                <Button Width="30" Height="30" Click="ClickMoveToPage2" Margin="10,0,0,0">

                    <!--Lưu ý: không thể ép Button nhận cả Content="Home" lẫn thẻ <Image> bên trong Một Button-->
                    <!--Add Image To Button (Thẻ Image phải ở trong thẻ Button)-->
                    <Image Height="24" Width="24" Source="Images/storage_24dp_FFFFFF_FILL0_wght400_GRAD0_opsz24.png"/>

                    <!--Tạo Style Cho Button (TargetType="Button" ==> chọn element để style là Button)-->
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="TextElement.FontFamily" Value="Fonts/#Dosis"/>
                            <Setter Property="Background" Value="#39385D"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Foreground" Value="White"/>
                            <!--Foreground ở đây là text của button đó-->
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF646287"/>

                                    <!--Trigger.EnterActions ==> Is An Action That Play When IsMouseOver is True (Chuột di chuyển qua cái nút)-->
                                    <Trigger.EnterActions>

                                        <!--Animation Tag Here (Storyboard allow us to group animation together )
                                        Storyboard.TargetProperty="Width" To="35" Duration="0:0:0.3" ==> change Button Width to 35 For 0.3 seconds When EnterActions
                                        -->
                                        <BeginStoryboard Name="MouseEnterStoryboard">
                                            <Storyboard>
                                                <DoubleAnimation  Storyboard.TargetProperty="Width" To="35" Duration="0:0:0.3"/>
                                                <DoubleAnimation  Storyboard.TargetProperty="Height" To="35" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>

                                    </Trigger.EnterActions>

                                    <!--Trigger.EnterActions ==> Is An Action That Play When IsMouseOver is False (Chuột Không di chuyển qua cái nút nữa)-->
                                    <Trigger.ExitActions>
                                        <!--Reset Storyboard trước để tránh bug Animation-->
                                        <StopStoryboard BeginStoryboardName="MouseEnterStoryboard"/>

                                        <!--Animation Tag Here (Storyboard allow us to group animation together )-->
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation  Storyboard.TargetProperty="Width" To="30" Duration="0:0:0.3"/>
                                                <DoubleAnimation  Storyboard.TargetProperty="Height" To="35" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>

                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <!--Apply cái mẫu Style Border này vào Background của Button bằng TemplateBinding-->
                            <Border  Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" CornerRadius="12" Background="{TemplateBinding Background}">


                                <!--Hiện content của button và style mới của nó(hiện:Text...) bằng ContentPresenter-->
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />


                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                </Button>
                <Button Width="30" Height="30" Click="ClickMoveToPage3" Margin="10,0,0,0">

                    <!--Lưu ý: không thể ép Button nhận cả Content="Home" lẫn thẻ <Image> bên trong Một Button-->
                    <!--Add Image To Button (Thẻ Image phải ở trong thẻ Button)-->
                    <Image Height="24" Width="24" Source="Images/mop_24dp_FFFFFF_FILL0_wght400_GRAD0_opsz24.png"/>

                    <!--Tạo Style Cho Button (TargetType="Button" ==> chọn element để style là Button)-->
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="TextElement.FontFamily" Value="Fonts/#Dosis"/>
                            <Setter Property="Background" Value="#FE6584"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Foreground" Value="White"/>
                            <!--Foreground ở đây là text của button đó-->
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF4C70"/>

                                    <!--Trigger.EnterActions ==> Is An Action That Play When IsMouseOver is True (Chuột di chuyển qua cái nút)-->
                                    <Trigger.EnterActions>

                                        <!--Animation Tag Here (Storyboard allow us to group animation together )
                                        Storyboard.TargetProperty="Width" To="35" Duration="0:0:0.3" ==> change Button Width to 35 For 0.3 seconds When EnterActions
                                        -->
                                        <BeginStoryboard Name="MouseEnterStoryboard">
                                            <Storyboard>
                                                <DoubleAnimation  Storyboard.TargetProperty="Width" To="35" Duration="0:0:0.3"/>
                                                <DoubleAnimation  Storyboard.TargetProperty="Height" To="35" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>

                                    </Trigger.EnterActions>

                                    <!--Trigger.EnterActions ==> Is An Action That Play When IsMouseOver is False (Chuột Không di chuyển qua cái nút nữa)-->
                                    <Trigger.ExitActions>
                                        <!--Reset Storyboard trước để tránh bug Animation-->
                                        <StopStoryboard BeginStoryboardName="MouseEnterStoryboard"/>

                                        <!--Animation Tag Here (Storyboard allow us to group animation together )-->
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation  Storyboard.TargetProperty="Width" To="30" Duration="0:0:0.3"/>
                                                <DoubleAnimation  Storyboard.TargetProperty="Height" To="35" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>

                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <!--Apply cái mẫu Style Border này vào Background của Button bằng TemplateBinding-->
                            <Border  Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" CornerRadius="12" Background="{TemplateBinding Background}">


                                <!--Hiện content của button và style mới của nó(hiện:Text...) bằng ContentPresenter-->
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />


                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                </Button>
            </StackPanel>

        </Grid>
    </Grid>
</Page>
