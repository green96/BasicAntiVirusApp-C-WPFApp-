<!--Thêm thuộc tính Background="White" cho thẻ Page và Grid để dễ thiết kế giao diện (WPF sẽ sử dụng 1 nên giao diện chung từ MainWindow Qua(Nên layout các Page phải giống layout MainWindow chỉ khác về Các UI,Button...))-->
<!--Title="AntivirusPage" Height="318" Width="530" ==> chỉnh width và height của page có title là AntivirusPage-->
<Page x:Class="WpfApplication1.AntivirusPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="300" d:DesignWidth="300"
	  Title="AntivirusPage" Height="318" Width="530"
      Background="White"
      >
    
    <!--Phải luôn có thẻ Window và Grid và các thành phần giao diện phải bỏ trong Thẻ Grid-->
    <Grid Margin="0,0,2,1">
            
        
             <!--Định nghĩa Height Width Row Và Column-->
        <Grid.RowDefinitions>
            <RowDefinition Height="318"> <!--Tạo 1 Row Chính có Height="318" ==> Cao Toàn Bộ Window-->
            </RowDefinition>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="530"> <!--Tạo 1 Column Chính có Width="530" ==> dài toàn window-->
            </ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid Background="#0F0F2D" Grid.ColumnSpan="1" >
            <!--Tạo 9 Column có độ dài bằng nhau để design cho đồng điều-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><!--Grid.Column="0"-->
                <ColumnDefinition/><!--Grid.Column="1"-->
                <ColumnDefinition/><!--Grid.Column="2"-->
                <ColumnDefinition/><!--Grid.Column="3"-->
                <ColumnDefinition/><!--Grid.Column="4"-->
                <ColumnDefinition/><!--Grid.Column="5"-->
                <ColumnDefinition/><!--Grid.Column="6"-->
                <ColumnDefinition/><!--Grid.Column="7"-->
                <ColumnDefinition/><!--Grid.Column="8"-->
            </Grid.ColumnDefinitions>

            <!--Tạo 9 Row có độ dài bằng nhau để design cho đồng điều-->
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition><!--Grid.Row="0"-->
                <RowDefinition></RowDefinition><!--Grid.Row="1"-->
                <RowDefinition></RowDefinition><!--Grid.Row="2"-->
                <RowDefinition></RowDefinition><!--Grid.Row="3"-->
                <RowDefinition></RowDefinition><!--Grid.Row="4"-->
                <RowDefinition></RowDefinition><!--Grid.Row="5"-->
                <RowDefinition></RowDefinition><!--Grid.Row="6"-->
                <RowDefinition></RowDefinition><!--Grid.Row="7"-->
                <RowDefinition></RowDefinition><!--Grid.Row="8"-->
            </Grid.RowDefinitions>

            <!--Grid.Column="1" ==> Element này xuất hiện ở column thứ 2-->
            <TextBlock Text="Bleu Basic"
                       Foreground="LightGray"
                       Grid.Column="3"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontFamily="/Fonts/#Dosis"
                       FontWeight="Medium"
                       />

            <TextBlock Text="AntiVirus"
                       Foreground="White"
                       Grid.Column="4"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontFamily="/Fonts/#Dosis"
                       FontWeight="Medium"
                       Cursor="Help"
                       />

            <TextBlock Text="PC Cleaner"
                       Foreground="LightGray"
                       Grid.Column="5"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontFamily="/Fonts/#Dosis"
                       FontWeight="Medium"
                       />
            
        <!-- Triggers the browse script
        Click="Tên_Của_Hàm_Được_Gọi_Khi_Click_Button_Này"
        -->
            
        <Button x:Name="BrowseButton"
        Content="Browse..."
        MinWidth="100"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Click="BrowseButton_Click" Cursor="Hand" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1">

                <!--Tạo Style Cho Button (TargetType="Button" ==> chọn element để style là Button)-->
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="TextElement.FontFamily" Value="Fonts/#Dosis"/>
                        <Setter Property="Background" Value="#FE6584"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Foreground" Value="White"/>
                        <!--Foreground ở đây là text của button đó-->
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF4C70"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <!--Apply cái mẫu Style Border này vào Background của Button bằng TemplateBinding-->
                        <Border Width="100" Height="25" CornerRadius="12" Background="{TemplateBinding Background}">


                            <!--Hiện content của button và style mới của nó(hiện:Text...) bằng ContentPresenter-->
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />


                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>
            
            <!--Cú pháp cơ bản: Content="Nội_Dung_Hiển_Thị_CủaButton..." 
            x:Name="Tên_Của_ElementNày_Để_Truy_xuất_Trong-Code" 
            Text="Text_Name" ==>  Nội_Dung_Hiển_Thị_Củatext
            -->
            
            <TextBlock Text="AntiVirus"
                       Foreground="White"
                       Grid.Column="4"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontFamily="/Fonts/#Dosis"
                       FontWeight="Medium"
                       Cursor="Help"
                       />
            <Label Content="File" 
                   Foreground="White"
                   Grid.Column="0"
                   Grid.Row="1"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   FontFamily="/Fonts/#Dosis"
                   FontWeight="Medium"
                  />
            
            <TextBlock x:Name="HiBox" 
                       Text="File" 
                       Foreground="White"
                       Grid.Column="0"
                       Grid.Row="2"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontFamily="/Fonts/#Dosis"
                       FontWeight="Medium"
                       />
            
            <TextBox x:Name="TbFilePath"
             TextWrapping="Wrap"
             Text="TextBox"
             MinWidth="100"
             Height="25"
             Padding="8,2"
             Grid.Column="1"
             Grid.Row="2"
             Grid.ColumnSpan="2">

                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="FontFamily" Value="Fonts/#Dosis"/>
                        <Setter Property="Background" Value="#39385D"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Cursor" Value="IBeam"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="8,2"/>

                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3952"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Background" Value="#3A3952"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>

                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Stretch"/>
                        </Border>
                    </ControlTemplate>
                </TextBox.Template>

            </TextBox>

            <TextBlock Text="MD5" 
                       Foreground="White"
                       Grid.Column="0"
                       Grid.Row="3"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontFamily="/Fonts/#Dosis"
                       FontWeight="Medium"/>

            <TextBox x:Name="TbMD5" TextWrapping="Wrap" Text="TextBox" MinWidth="100"
             Height="25"
             Padding="8,2"
             Grid.Column="1"
             Grid.Row="3"
             Grid.ColumnSpan="2">
                <TextBox.Style>
                <Style TargetType="TextBox">
                    <Setter Property="FontFamily" Value="Fonts/#Dosis"/>
                    <Setter Property="Background" Value="#39385D"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Cursor" Value="IBeam"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="8,2"/>

                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#3A3952"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Background" Value="#3A3952"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                </TextBox.Style>

                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Stretch"/>
                        </Border>
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>
            <Label x:Name="StatusLabel"  Content="Status: N/A" 
                   Foreground="White"
                   Grid.Column="0"
                   Grid.Row="4"
                   Grid.ColumnSpan="2"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   FontFamily="/Fonts/#Dosis"
                   FontWeight="Medium"
                   />
            <Button x:Name="HiButton" Content="Scan" Click="ButtonScan_Click" Cursor="Hand" Grid.Column="2" Grid.Row="4">
                <!--Tạo Style Cho Button (TargetType="Button" ==> chọn element để style là Button)-->
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="TextElement.FontFamily" Value="Fonts/#Dosis"/>
                        <Setter Property="Background" Value="#FE6584"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Foreground" Value="White"/>
                        <!--Foreground ở đây là text của button đó-->
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF4C70"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <!--Apply cái mẫu Style Border này vào Background của Button bằng TemplateBinding-->
                        <Border Width="50" Height="25" CornerRadius="12" Background="{TemplateBinding Background}">


                            <!--Hiện content của button và style mới của nó(hiện:Text...) bằng ContentPresenter-->
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />


                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!--StackPanel giống flexbox css nhưng mặc định từ trên xuống (giống Stack) ==> Orientation="Horizontal" để override mặc định ==> hiện từ trái qua phải-->
            <!--Grid.Column="3": bắt đầu từ cột thứ 4 (đếm từ 0). Grid.ColumnSpan="4": chiếm 4 cột liên tiếp từ cột đã chọn, tức là Grid.Column=3,4,5,6 (hiểu tương tự với Grid.Row="6")-->
            <StackPanel Grid.Row="7" Grid.Column="3" Grid.ColumnSpan="4" Orientation="Horizontal" Height="35" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform Y="-7"/>
                    </TransformGroup>
                </StackPanel.RenderTransform>
                <!--Add Image To Button (Thẻ Image phải ở trong thẻ Button)-->
                <Button Width="30" Height="30" Click="ClickBackToMain">

                    <!--Lưu ý: không thể ép Button nhận cả Content="Home" lẫn thẻ <Image> bên trong Một Button-->
                    <!--Add Image To Button (Thẻ Image phải ở trong thẻ Button)-->
                    <Image Height="24" Width="24" Source="Images/home_and_garden_24dp_FFFFFF_FILL0_wght400_GRAD0_opsz24.png"/>


                    <!--Tạo Style Cho Button (TargetType="Button" ==> chọn element để style là Button)-->
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="TextElement.FontFamily" Value="Fonts/#Dosis"/>
                            <Setter Property="Background" Value="#39385D"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Foreground" Value="White"/>
                            <!--Foreground ở đây là text của button đó-->

                            <!--Xử lý sự kiện Trigger và Animation bằng Storyboards VD: OnClick,IsMouseOver-->
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">

                                    <!--Setter ==> gán các thuộc tính của button khi IsMouseOver-->
                                    <Setter Property="Background" Value="#FF646287"/>

                                    <!--Trigger.EnterActions ==> Is An Action That Play When IsMouseOver is True (Chuột di chuyển qua cái nút)-->
                                    <Trigger.EnterActions>

                                        <!--Animation Tag Here (Storyboard allow us to group animation together )
                                        Storyboard.TargetProperty="Width" To="35" Duration="0:0:0.3" ==> change Button Width to 35 For 0.3 seconds When EnterActions
                                        -->
                                        <BeginStoryboard Name="MouseEnterStoryboard">
                                            <Storyboard>
                                                <DoubleAnimation  Storyboard.TargetProperty="Width" To="35" Duration="0:0:0.3"/>
                                                <DoubleAnimation  Storyboard.TargetProperty="Height" To="35" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>

                                    </Trigger.EnterActions>

                                    <!--Trigger.EnterActions ==> Is An Action That Play When IsMouseOver is False (Chuột Không di chuyển qua cái nút nữa)-->
                                    <Trigger.ExitActions>
                                        <!--Reset Storyboard trước để tránh bug Animation-->
                                        <StopStoryboard BeginStoryboardName="MouseEnterStoryboard"/>

                                        <!--Animation Tag Here (Storyboard allow us to group animation together )-->
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation  Storyboard.TargetProperty="Width" To="30" Duration="0:0:0.3"/>
                                                <DoubleAnimation  Storyboard.TargetProperty="Height" To="30" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>

                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <!--Apply cái mẫu Style Border này vào Background của Button bằng TemplateBinding
                            Width="{TemplateBinding Width} ==> Apply thuộc tính Width đã tạo ở trên Của Button vào Border
                            Height="{TemplateBinding Height ==> Apply thuộc tính Width đã tạo ở trên Của Button vào Border
                            -->
                            <Border Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" CornerRadius="12" Background="{TemplateBinding Background}">


                                <!--Hiện content của button và style mới của nó(hiện:Text...) bằng ContentPresenter-->
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />


                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                </Button>
                <Button  Width="30" Height="30" Click="ClickMoveToPage1" Margin="10,0,0,0">

                    <!--Lưu ý: không thể ép Button nhận cả Content="Home" lẫn thẻ <Image> bên trong Một Button-->
                    <!--Add Image To Button (Thẻ Image phải ở trong thẻ Button)-->
